# ---------------------------------------------------------------------------
# 运行时数据（不应提交）
# ---------------------------------------------------------------------------
# 便携模式数据目录
data/
# 配置与日志（可能含用户环境信息）
*.log
logs/
# 翻译历史数据库（含屏幕识别内容，隐私敏感）
*.db
*.db-wal
*.db-shm
# 模型权重（体积大，按需下载；请勿提交到版本库）
# 交付目录中已包含权重文件，但版本控制应排除它们——3.45GB 不适合入库。
# 需要时用 scripts/download_models.py 重新获取（带 SHA256 校验）。
*.gguf
models/*
# 但保留目录说明，让克隆者知道该目录的用途与获取方式
!models/README.md

# 推理运行时（llama-server 可执行文件与 DLL，约 600MB）
# 交付目录中已包含，但同样不适合入库；需要时用 scripts/download_runtime.py 获取。
runtime/
# OCR 模型缓存
ocr_models/

