# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# 注意：不要在此写 build/ —— 那会把 build/build_exe.py 与 build/installer.iss
# 这两个源码文件一并排除，干净克隆后 tests/test_build_exe_smoke.py 无法加载
# 构建脚本，pytest collection 阶段即失败。产物由下方 build/Output/ 精确排除。
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
.venv/
venv/
ENV/
env/

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ---------------------------------------------------------------------------
# 打包产物
# ---------------------------------------------------------------------------
# PyInstaller
*.spec.bak
# Inno Setup 输出
build/Output/
# PyInstaller onedir 输出
build/dist/
*.exe

# ---------------------------------------------------------------------------
# 运行时数据（不应提交）
# ---------------------------------------------------------------------------
# 便携模式数据目录
data/
# 配置与日志（可能含用户环境信息）
*.log
logs/
# 翻译历史数据库（含屏幕识别内容，隐私敏感）
*.db
*.db-wal
*.db-shm
# 模型权重（体积大，按需下载；请勿提交到版本库）
# 交付目录中已包含权重文件，但版本控制应排除它们——3.45GB 不适合入库。
# 需要时用 scripts/download_models.py 重新获取（带 SHA256 校验）。
*.gguf
models/*
# 但保留目录说明，让克隆者知道该目录的用途与获取方式
!models/README.md

# 推理运行时（llama-server 可执行文件与 DLL，约 600MB）
# 交付目录中已包含，但同样不适合入库；需要时用 scripts/download_runtime.py 获取。
# 注意：不能用 runtime/* 再配合 !runtime/llama/README.md 豁免——git 对已被排除的
# 目录不再递归，豁免规则不会生效。因此逐个目录精确排除，README 单独放行。
runtime/llama/*
!runtime/llama/README.md
# OCR 模型缓存
ocr_models/

# ---------------------------------------------------------------------------
# 编辑器与系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Office 临时文件
~$*

# ---------------------------------------------------------------------------
# 开发过程产物（体量大且无开源价值，不入库）
# ---------------------------------------------------------------------------
artifacts/
research/
managed_iterations/
.opencode/
.pytest_cache/
.ruff_cache/
build_log*.txt
_app_err.txt
_app_out.txt
_pid.txt
_dbg_*.png

# 本地运行/构建产物与误生成的重定向垃圾
build/work/
=1.8
nul
old_tray_active.png
